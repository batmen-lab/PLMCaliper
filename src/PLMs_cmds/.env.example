# Environment for the PLM search wrappers (run_*_single*.sh) and the ColabFold pipelines.
#
#   cp src/PLMs_cmds/.env.example src/PLMs_cmds/.env
#   # then edit .env to match your machine
#
# Every script starts with `source src/PLMs_cmds/.env`, so .env must exist before you run
# anything. It is intentionally NOT committed (it holds machine-specific paths).
#
# Each retriever needs its own conda env: their dependencies conflict and cannot be merged.

# ---- repo layout ----
BASE_DIR="/path/to/2025_yifan_plmfool"     # repo root (absolute)
DATA_DIR="$BASE_DIR/data"
TEMP_DIR="$BASE_DIR/data/temp"

# ---- interpreters ----
# EVALPLMS_PYTHON_PATH  pipeline / ColabFold folding driver
# CALIB_FDR_PYTHON      calibration + FDR + evaluation (numpy / pandas / cvxpy / pygam)
EVALPLMS_PYTHON_PATH="/path/to/conda/envs/evalplms/bin/python"
CALIB_FDR_PYTHON="/path/to/conda/envs/calib_gam/bin/python"

# ---- BLASTp (CPU only) ----
BLASTP_PYTHON_PATH="/path/to/conda/envs/plmfooler/bin/python"
BLASTP_NUM_PARALLEL=8                      # concurrent blastp processes

# ---- DCTdomain ----
DCT_DOMAIN_PYTHON_PATH="/path/to/conda/envs/dctdomain/bin/python"
DCT_DOMAIN_SRC_DIR="$BASE_DIR/libs/DCTdomain"
DCT_DOMAIN_GPU_DEVICES=0,1                 # comma-separated CUDA device ids
DCT_DOMAIN_NUM_PARALLEL=2                  # workers; keep <= number of GPUs listed above

# ---- DHR (Dense Homolog Retrieval) ----
DHR_PYTHON_PATH="/path/to/conda/envs/dhr/bin/python"
DHR_SRC_DIR="$BASE_DIR/libs/Dense-Homolog-Retrieval-main"
DHR_GPU_DEVICES=0,1
DHR_NUM_PARALLEL=2

# ---- PLMSearch ----
PLMSEARCH_PYTHON_PATH="/path/to/conda/envs/plmsearch/bin/python"
PLMSEARCH_SRC_DIR="$BASE_DIR/libs/PLMSearch"
PLMSEARCH_GPU_DEVICES=0,1
PLMSEARCH_NUM_PARALLEL=2

# ---- TM-vec / DeepBLAST ----
TMVEC_PYTHON_PATH="/path/to/conda/envs/tmvec/bin/python"
TMVEC_SRC_DIR="$BASE_DIR/libs/tm-vec-master"
TMVEC_GPU_DEVICES=0,1
TMVEC_NUM_PARALLEL=2

# ---- external binaries ----
# qjackhmmer ships with DHR; ColabFold is installed separately (localcolabfold).
QJACKHMMER_BIN="$DHR_SRC_DIR/bin/qjackhmmer"
COLABFOLD_BIN="/path/to/localcolabfold/colabfold-conda/bin"
COLABFOLD_BATCH="$COLABFOLD_BIN/colabfold_batch"
